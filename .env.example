# ===================================================================
# QuantroBill POS — Environment Variables Template
# Copy this file to .env and fill in your actual credentials.
# NEVER commit .env with real credentials to version control.
# ===================================================================

# MongoDB Atlas Connection String
# Example: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/QuantroBill?retryWrites=true&w=majority
MONGODB_CONNECTION_STRING=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/QuantroBill?retryWrites=true&w=majority
MONGODB_DATABASE_NAME=QuantroBill

# ASP.NET Core Environment (Development or Production)
ASPNETCORE_ENVIRONMENT=Development

# JWT Authentication
JWT_KEY=YOUR_SECURE_JWT_SECRET_KEY_MIN_32_CHARACTERS
JWT_ISSUER=QuantroBillAPI
JWT_AUDIENCE=QuantroBillClient
JWT_EXPIRY_MINUTES=720

# CORS Allowed Origins
ALLOWED_ORIGIN_0=http://localhost:5173
ALLOWED_ORIGIN_1=https://quantrobill.quantromind.com

# Automated Email Gateway (SMTP)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=mailer@example.com
SMTP_PASSWORD=YOUR_SMTP_PASSWORD
SMTP_FROM_EMAIL=notifications@example.com

# Payment Gateway (Razorpay)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=YOUR_RAZORPAY_SECRET

# Swagger UI & Seeding
SWAGGER_ENABLED=true
FORCE_SEED=false
